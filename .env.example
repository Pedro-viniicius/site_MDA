# ==============================================================
# MDA Soluções em Tecnologia — Variáveis de ambiente (exemplo)
# Copie este arquivo para .env e ajuste os valores conforme necessário:
#   cp .env.example .env
# NUNCA versione o arquivo .env com segredos reais.
# ==============================================================

# --- Banco de dados (PostgreSQL) ---
POSTGRES_USER=mda
POSTGRES_PASSWORD=mda_senha_dev
POSTGRES_DB=mda
# URL usada pela API (dentro do Docker o host é "db"; fora do Docker use "localhost:5433")
DATABASE_URL=postgresql+psycopg://mda:mda_senha_dev@db:5432/mda

# --- API (FastAPI) ---
# Origens permitidas para CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# --- Inteligência Artificial ---
# Provedor de IA para gerar explicações: mock | anthropic | openai
# "mock" funciona sem nenhuma chave e é o padrão para desenvolvimento.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Frontend (Next.js) ---
# URL da API vista pelo NAVEGADOR do usuário (porta 8001 no host)
NEXT_PUBLIC_API_URL=http://localhost:8001
# URL da API vista pelo SERVIDOR Next.js (dentro do Docker o host é "api")
API_URL_INTERNA=http://api:8000
